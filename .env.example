# Optional overrides for compose.yaml. Every value below already has a working
# default, so `docker compose up -d` runs without this file.
#
# Copy to .env only when you need to change something. .env is gitignored.

# Published ports. Keep the UI's config.json address in sync with
# AHP_GATEWAY_PORT, and the gateway file's listener.port with the container side.
UI_PORT=9000
AHP_GATEWAY_PORT=8765

# Native ahp-acp-gateway configuration, mounted read-only at
# /etc/ahp/gateway.json and used unchanged. To edit it without touching the
# example:
#   cp gateway.example.json gateway.json
#   AHP_GATEWAY_CONFIG=./gateway.json
AHP_GATEWAY_CONFIG=./gateway.example.json

# UI agent-host list, mounted at /config.json. Its connectionToken must match
# the auth.token in the gateway file.
AHP_CONFIG_FILE=./agent-hosts.example.json

# Credentials for the provider processes. They are inherited by pi and the
# Copilot CLI, so they are not written into the gateway file. Empty is allowed:
# the gateway starts, but pi and the BYOK providers cannot reach a model until
# a key is set.
DEEPSEEK_API_KEY=
COPILOT_GITHUB_TOKEN=

# No agent is baked into the gateway image. The `agents` init service installs
# these pinned versions into the agents volume before the gateway starts.
PI_ACP_VERSION=0.0.34
PI_VERSION=1.5.0
COPILOT_VERSION=1.0.107
AGY_VERSION=1.5.3

# Optional host path to the Antigravity CLI binary. When set, the init service
# copies it into the agents volume as `agy`. Leave unset to skip it.
# AGY_BIN=/usr/local/bin/agy

# Image pins. GATEWAY_IMAGE is the published gateway; set it to a local tag to
# use a build instead of the registry.
AHP_GATEWAY_VERSION=0.2.2
GATEWAY_IMAGE=ghcr.io/vanduc2514/ahp-gateway
AGENTS_IMAGE=node:24-bookworm-slim

# Code - OSS image. Use a local build with UI_IMAGE=code-oss-container:local.
UI_IMAGE=ghcr.io/vanduc2514/code-oss-container:latest
