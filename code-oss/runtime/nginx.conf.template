server {
	listen 80;
	listen [::]:80;
	server_name _;

	root /usr/share/nginx/html;
	index index.html;

	charset utf-8;
	server_tokens off;
	absolute_redirect off;
	client_max_body_size 0;

	types {
		text/html html htm;
		text/css css;
		application/javascript js mjs;
		application/json json map jsonc;
		application/manifest+json webmanifest;
		application/wasm wasm;
		image/svg+xml svg svgz;
		image/png png;
		image/jpeg jpg jpeg;
		image/x-icon ico;
		font/woff2 woff2;
		font/woff woff;
		font/ttf ttf;
		text/plain txt;
		text/markdown md;
	}

	gzip on;
	gzip_comp_level 5;
	gzip_min_length 1024;
	gzip_proxied any;
	gzip_vary on;
	gzip_types
		application/javascript
		application/json
		application/manifest+json
		application/wasm
		image/svg+xml
		text/css
		text/plain;

	# A location with any add_header drops the server-level ones, so every
	# location below repeats these alongside its own headers.
	add_header X-Content-Type-Options nosniff always;
	add_header Referrer-Policy no-referrer always;

	location = /healthz {
		access_log off;
		default_type text/plain;
		return 200 "ok\n";
	}

	location = /config.json {
		add_header Cache-Control "no-store" always;
		add_header X-Content-Type-Options nosniff always;
		add_header Referrer-Policy no-referrer always;
		try_files $uri =404;
	}

	location = /agents {
		add_header Cache-Control "no-cache" always;
		add_header X-Content-Type-Options nosniff always;
		add_header Referrer-Policy no-referrer always;
		try_files /agents.html =404;
	}

	location = /agents/ {
		return 308 /agents;
	}

	# Agent-host proxy routes, generated at container start from the
	# remoteAgentHosts entries that declare an "upstream". One exact-match
	# location per host, so the browser only ever reaches this origin and
	# nginx makes the hop into the private network.
	include /etc/nginx/ahp/*.conf;

	# Prefix fallback: exact routes above win, so an unconfigured /ahp path
	# fails loudly instead of returning the workbench HTML.
	location /ahp {
		return 404;
	}

	location /out/ {
		add_header Cache-Control "public, max-age=31536000, immutable" always;
		add_header X-Content-Type-Options nosniff always;
		add_header Referrer-Policy no-referrer always;
		try_files $uri =404;
	}

	location /extensions/ {
		add_header Cache-Control "public, max-age=31536000, immutable" always;
		add_header X-Content-Type-Options nosniff always;
		add_header Referrer-Policy no-referrer always;
		try_files $uri =404;
	}

	location / {
		add_header Cache-Control "no-cache" always;
		add_header X-Content-Type-Options nosniff always;
		add_header Referrer-Policy no-referrer always;
		try_files $uri $uri/ /index.html;
	}
}
